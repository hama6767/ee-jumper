<?xml version="1.0"?>
<package format="3">
  <name>ee_jumper</name>
  <version>0.1.0</version>
  <description>MuJoCo swimming simulator and ROS 2 XYZ teleoperation for Jumper.</description>
  <maintainer email="Yuya.Hamamatsu@taltech.ee">Yuya Hamamatsu</maintainer>
  <url type="repository">https://github.com/hama6767/ee-jumper</url>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
